modules = ["nodejs-20"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Posture Coach"

[[workflows.workflow]]
name = "Posture Coach"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/COACH-POSTURA/COACH-POSTURA/COACH-POSTURA/COACH-POSTURA/app/coach/coach-traspaso/coach/artifacts/posture-coach && PORT=5000 BASE_PATH=/ pnpm run dev -- --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
