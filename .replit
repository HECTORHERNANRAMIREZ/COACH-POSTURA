modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]

[userenv]

[userenv.shared]
LEMON_SQUEEZY_MODE = "live"
LEMON_SQUEEZY_STORE_SLUG = "pagos"
LEMON_SQUEEZY_VARIANT_ID = "2029790"
